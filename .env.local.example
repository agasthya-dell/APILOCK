# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your project values.
# Find both values at: https://supabase.com/dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── GitHub OAuth App (optional — Supabase handles OAuth when configured) ────
# Only needed if you are NOT using the Supabase GitHub provider.
# VITE_GITHUB_CLIENT_ID=your-github-oauth-app-client-id
